# Loop — root .env.example
# Copy to .env and fill in real values. NEVER commit .env.
# This file is also read by docker-compose.yml (MySQL passwords etc.).
# backend/.env and frontend/.env.local hold their own variables.

# ── Docker Compose / MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=loop
DB_USER=loop_app
DB_PASSWORD=change_me_app_password

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change_me_at_least_50_random_chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS / Frontend URLs ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://backend:8000

# ── Email (leave blank in local dev to print to console) ─────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@loop.example
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# ── Object storage (Cloudflare R2 / AWS S3) ── added by Task 03 ──────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Sentry / monitoring ── added later ───────────────────────────────────────
# SENTRY_DSN=
