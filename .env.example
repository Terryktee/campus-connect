# Docker Compose variables shared by MySQL and the backend.
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=campus_loop_zw
DB_USER=campus_loop_app
DB_PASSWORD=change_me_app_password

# Used by the backend image when backend/.env is not present.
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
