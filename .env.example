# Docker Compose variables shared by MySQL and the backend.
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=campus_loop_zw
DB_USER=campus_loop_app
DB_PASSWORD=change_me_app_password

# Used by the backend image when backend/.env is not present.
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Browser/API and Celery service settings.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional local email settings used by the backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@campusloop.local
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
