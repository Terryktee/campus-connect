# Copy this to .env at the repo root, and also create backend/.env and
# frontend/.env.local as described in the READMEs below. Values here are
# used by docker-compose.yml itself (mysql root password, etc.) — the
# backend and frontend have their own .env files with the values they
# individually need.

MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=campus_loop_zw
DB_USER=campus_loop_app
DB_PASSWORD=change_me_app_password
