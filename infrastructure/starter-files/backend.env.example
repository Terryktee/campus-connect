# Save this as backend/.env.example, then copy to backend/.env and fill in.
# When running via docker-compose, DB_HOST/DB_PORT/REDIS_URL are overridden
# by the compose file automatically (see docker-compose.yml) — these values
# only matter if you run the backend outside Docker.

DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_NAME=campus_loop_zw
DB_USER=campus_loop_app
DB_PASSWORD=change_me_app_password
DB_HOST=localhost
DB_PORT=3306

REDIS_URL=redis://localhost:6379/0

# CORS: only the frontend's real origin(s), comma-separated. Never *.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email provider — fill in once you have one; leave blank in local dev to
# fall back to Django's console email backend, which just prints emails
# to the backend container's logs instead of sending them.
RESEND_API_KEY=
