# Save this as frontend/.env.local.example, then copy to frontend/.env.local

# Must be reachable from the BROWSER, not just from inside Docker's network.
# That's why this is localhost:8000 (the published port) even though the
# frontend container internally could also reach the backend at
# http://backend:8000 — that internal address only works for server-side
# code running inside the frontend container (e.g. a Route Handler acting
# as a proxy), never for client-side fetch calls, which run in the user's
# actual browser outside Docker entirely.
NEXT_PUBLIC_API_URL=http://localhost:8000
